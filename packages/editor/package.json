{
  "name": "@transient/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run --parallel type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:all": "bun test && bun test:e2e",
    "test:e2e": "bun --bun x playwright test",
    "test:e2e:ui": "bun --bun x playwright test --ui",
    "test:e2e:report": "bun --bun x playwright test --reporter=html && bun --bun x playwright show-report"
  },
  "dependencies": {
    "@transient/core": "workspace:*",
    "@transient/ir": "workspace:*",
    "@nuxt/ui": "^3.0.2",
    "@vueuse/core": "^13.0.0",
    "lucide-vue-next": "^0.516.0",
    "vue": "^3.5.13",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify-json/lucide": "^1.2.147",
    "@playwright/test": "^1.63.0",
    "@transient/vite-plugin-transient-analyzer": "workspace:*",
    "@tsconfig/node22": "^22.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  }
}
