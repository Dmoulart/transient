{
  "name": "@transient/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test:all": "bun test && bun test:e2e",
    "test:e2e": "bun --bun x playwright test",
    "test:e2e:ui": "bun --bun x playwright test --ui",
    "test:e2e:report": "bun --bun x playwright test --reporter=html && bun --bun x playwright show-report"
  },
  "dependencies": {
    "@transient/core": "workspace:*",
    "@transient/ir": "workspace:*",
    "@vueuse/core": "^13.0.0",
    "lucide-vue-next": "^0.516.0",
    "vue": "^3.5.13",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@iconify-json/lucide": "^1.2.147"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@transient/vite-plugin-vue-transient": "workspace:*",
    "@tsconfig/node22": "^22.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./style.css": "./dist/editor.css"
  }
}
