{
  "name": "bridge",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "ci": "biome ci && bun run build && bun run type-check && bun run test",
    "type-check": "bun check && bun run --cwd packages/editor type-check",
    "dev": "tsc -b && bun run --parallel watch dev:editor",
    "dev:editor": "bun run --cwd packages/editor dev",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "build": "tsc -b",
    "test": "bun test src/"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.8.2"
  }
}